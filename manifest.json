{
  "manifest_version": 3,
  "name": "AI Mode Redirect",
  "version": "1.0.0",
  "description": "Click to open Google AI Mode. On Brave Search pages, extracts your search term and opens it in Google AI Mode.",
  "action": {
    "default_title": "Open Google AI Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ]
}
