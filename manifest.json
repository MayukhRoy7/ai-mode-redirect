{
  "manifest_version": 3,
  "name": "AI Mode Redirect",
  "version": "2.0.0",
  "description": "One-click redirect to your preferred AI mode. Configure your search engine (Brave or Google) and AI mode provider (Brave or Google) via the options page.",
  "action": {
    "default_title": "Open AI Mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ]
}
